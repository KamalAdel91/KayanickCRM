{
 "doctype": "DocType",
 "name": "KC Case",
 "module": "KAYANICK CRM",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "CASE-.YYYY.-.####",
   "reqd": 1,
   "default": "CASE-.YYYY.-.####",
   "hidden": 1
  },
  {
   "fieldname": "hospital",
   "fieldtype": "Link",
   "label": "Hospital",
   "options": "KC Hospital",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "doctor",
   "fieldtype": "Link",
   "label": "Doctor",
   "options": "KC Doctor",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "case_date",
   "fieldtype": "Date",
   "label": "Case Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "case_time",
   "fieldtype": "Time",
   "label": "Case Time",
   "reqd": 1,
   "in_list_view": 1,
   "description": "What time the case will be attended"
  },
  {
   "fieldname": "attended",
   "fieldtype": "Check",
   "label": "Attended",
   "default": "0",
   "in_list_view": 1,
   "description": "Leave unticked for a planned case; it shows in the follow-ups until it is marked attended"
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break",
   "label": "Cb 1"
  },
  {
   "fieldname": "sales_rep",
   "fieldtype": "Link",
   "label": "Sales Rep",
   "options": "User",
   "reqd": 1,
   "default": "__user",
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "sb_products",
   "fieldtype": "Section Break",
   "label": "Products"
  },
  {
   "fieldname": "products",
   "fieldtype": "Table MultiSelect",
   "label": "Products",
   "options": "KC Case Product",
   "reqd": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes",
   "reqd": 1
  },
  {
   "fieldname": "sb_used",
   "fieldtype": "Section Break",
   "label": "Used Products",
   "depends_on": "eval:doc.attended"
  },
  {
   "fieldname": "used_products",
   "fieldtype": "Select",
   "label": "Used Products?",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.attended",
   "mandatory_depends_on": "eval:doc.attended",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Info only, does not touch stock"
  },
  {
   "fieldname": "used_items",
   "fieldtype": "Table",
   "label": "Used Items",
   "options": "KC Case Used Item",
   "depends_on": "eval:doc.attended && doc.used_products=='Yes'",
   "mandatory_depends_on": "eval:doc.attended && doc.used_products=='Yes'"
  }
 ],
 "field_order": [
  "naming_series",
  "hospital",
  "doctor",
  "case_date",
  "case_time",
  "attended",
  "cb_1",
  "sales_rep",
  "sb_products",
  "products",
  "notes",
  "sb_used",
  "used_products",
  "used_items"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales Rep",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "row_format": "Dynamic",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "hospital",
 "search_fields": "hospital,doctor"
}
