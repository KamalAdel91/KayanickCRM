{
 "doctype": "DocType",
 "name": "KC Case",
 "module": "KAYANICK CRM",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "CASE-.YYYY.-.####",
   "reqd": 1,
   "default": "CASE-.YYYY.-.####",
   "hidden": 1
  },
  {
   "fieldname": "hospital",
   "fieldtype": "Link",
   "label": "Hospital",
   "options": "KC Hospital",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "case_date",
   "fieldtype": "Date",
   "label": "Case Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "case_time",
   "fieldtype": "Time",
   "label": "Case Time",
   "reqd": 1,
   "description": "What time the case will be attended"
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break",
   "label": "Cb 1"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Planned\nAttended\nCancelled",
   "default": "Planned",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "description": "Planned cases are visible to the whole team; once attended the case belongs to whoever attended it."
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Attended By",
   "options": "Employee",
   "depends_on": "eval:doc.status=='Attended'",
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Attended By Name",
   "fetch_from": "employee.employee_name",
   "read_only": 1,
   "in_list_view": 1,
   "depends_on": "eval:doc.status=='Attended'"
  },
  {
   "fieldname": "sb_doctors",
   "fieldtype": "Section Break",
   "label": "Doctors"
  },
  {
   "fieldname": "doctors",
   "fieldtype": "Table",
   "label": "Doctors",
   "options": "KC Case Doctor",
   "reqd": 1
  },
  {
   "fieldname": "sb_products",
   "fieldtype": "Section Break",
   "label": "Products"
  },
  {
   "fieldname": "products",
   "fieldtype": "Table MultiSelect",
   "label": "Products",
   "options": "KC Case Product",
   "reqd": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes",
   "reqd": 1
  },
  {
   "fieldname": "sb_used",
   "fieldtype": "Section Break",
   "label": "Used Products",
   "depends_on": "eval:doc.status=='Attended'"
  },
  {
   "fieldname": "used_products",
   "fieldtype": "Select",
   "label": "Used Products?",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.status=='Attended'",
   "mandatory_depends_on": "eval:doc.status=='Attended'",
   "in_standard_filter": 1,
   "description": "Info only, does not touch stock"
  },
  {
   "fieldname": "used_items",
   "fieldtype": "Table",
   "label": "Used Items",
   "options": "KC Case Used Item",
   "depends_on": "eval:doc.status=='Attended' && doc.used_products=='Yes'",
   "mandatory_depends_on": "eval:doc.status=='Attended' && doc.used_products=='Yes'"
  },
  {
   "fieldname": "attended_notes",
   "fieldtype": "Small Text",
   "label": "Attendance Notes",
   "depends_on": "eval:doc.status=='Attended'",
   "mandatory_depends_on": "eval:doc.status=='Attended'"
  },
  {
   "fieldname": "sb_log",
   "fieldtype": "Section Break",
   "label": "History",
   "collapsible": 1,
   "depends_on": "eval:(doc.log || []).length"
  },
  {
   "fieldname": "log",
   "fieldtype": "Table",
   "label": "History",
   "options": "KC Case Log",
   "read_only": 1
  }
 ],
 "field_order": [
  "naming_series",
  "hospital",
  "case_date",
  "case_time",
  "cb_1",
  "status",
  "employee",
  "employee_name",
  "sb_doctors",
  "doctors",
  "sb_products",
  "products",
  "notes",
  "sb_used",
  "used_products",
  "used_items",
  "attended_notes",
  "sb_log",
  "log"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "KC Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "KC Rep",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "KC Viewer",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "row_format": "Dynamic",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "hospital",
 "search_fields": "hospital,status"
}