  },
  {
   "role": "Sales Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales Rep",
   "read": 1,
   "report": 1,
   "print": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
