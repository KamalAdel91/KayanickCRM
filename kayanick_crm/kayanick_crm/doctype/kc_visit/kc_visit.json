{
 "doctype": "DocType",
 "name": "KC Visit",
 "module": "KAYANICK CRM",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "VISIT-.YYYY.-.####",
   "reqd": 1,
   "default": "VISIT-.YYYY.-.####",
   "hidden": 1
  },
  {
   "fieldname": "visit_date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "sales_rep",
   "fieldtype": "Link",
   "label": "Sales Rep",
   "options": "User",
   "reqd": 1,
   "default": "__user",
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "hospital",
   "fieldtype": "Link",
   "label": "Hospital",
   "options": "KC Hospital",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "doctor",
   "fieldtype": "Link",
   "label": "Primary Doctor",
   "options": "KC Doctor",
   "reqd": 0,
   "search_index": 1,
   "read_only": 1,
   "hidden": 1,
   "description": "First doctor in the Doctors table (kept in sync automatically)"
  },
  {
   "fieldname": "doctors",
   "fieldtype": "Table MultiSelect",
   "label": "Doctors",
   "options": "KC Visit Doctor",
   "reqd": 1
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break",
   "label": "Cb 1"
  },
  {
   "fieldname": "visit_purpose",
   "fieldtype": "Link",
   "label": "Visit Purpose",
   "options": "KC Visit Purpose",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "fieldname": "visit_outcome",
   "fieldtype": "Link",
   "label": "Visit Outcome",
   "options": "KC Visit Outcome",
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "fieldname": "relationship_level",
   "fieldtype": "Link",
   "label": "Relationship Level",
   "options": "KC Relationship Level",
   "fetch_from": "doctor.relationship_level",
   "fetch_if_empty": 1,
   "reqd": 1
  },
  {
   "fieldname": "order_expected",
   "fieldtype": "Check",
   "label": "Order Expected",
   "in_standard_filter": 1
  },
  {
   "fieldname": "sb_details",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "products",
   "fieldtype": "Table MultiSelect",
   "label": "Product Discussed",
   "options": "KC Visit Product",
   "reqd": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text",
   "label": "Notes"
  },
  {
   "fieldname": "sb_next_step",
   "fieldtype": "Section Break",
   "label": "Next Step"
  },
  {
   "fieldname": "next_action",
   "fieldtype": "Small Text",
   "label": "Next Action",
   "reqd": 1
  },
  {
   "fieldname": "has_next_visit",
   "fieldtype": "Select",
   "label": "Next Visit Planned?",
   "options": "\nYes\nNo",
   "reqd": 1
  },
  {
   "fieldname": "next_visit_date",
   "fieldtype": "Date",
   "label": "Next Visit Date",
   "search_index": 1,
   "depends_on": "eval:doc.has_next_visit=='Yes'",
   "mandatory_depends_on": "eval:doc.has_next_visit=='Yes'"
  },
  {
   "fieldname": "sb_check_in",
   "fieldtype": "Section Break",
   "label": "Check-in",
   "collapsible": 1
  },
  {
   "fieldname": "check_in_time",
   "fieldtype": "Datetime",
   "label": "Check-in Time",
   "read_only": 1
  },
  {
   "fieldname": "geolocation",
   "fieldtype": "Geolocation",
   "label": "Location",
   "read_only": 1
  }
 ],
 "field_order": [
  "naming_series",
  "visit_date",
  "sales_rep",
  "hospital",
  "doctor",
  "doctors",
  "cb_1",
  "visit_purpose",
  "visit_outcome",
  "relationship_level",
  "order_expected",
  "sb_details",
  "products",
  "notes",
  "sb_next_step",
  "next_action",
  "has_next_visit",
  "next_visit_date",
  "sb_check_in",
  "check_in_time",
  "geolocation"
